{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "e-sugid",
          "appId": "1:1072913761483:android:2e39121ea8aba4dfd8874e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "e-sugid",
          "configurations": {
            "android": "1:1072913761483:android:2e39121ea8aba4dfd8874e"
          }
        }
      }
    }
  },
  "storage": { "rules": "storage.rules" },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": { "source": "functions", "runtime": "nodejs22" },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "functions": { "host": "127.0.0.1", "port": 5005 },
    "firestore": { "host": "127.0.0.1", "port": 8085 },
    "storage": { "host": "127.0.0.1", "port": 9195 }
  },
  "hosting": {
    "public": "deploy_web",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [],
    "rewrites": [
      { "source": "/admin/**", "destination": "/admin/index.html" },
      { "source": "/admin", "destination": "/admin/index.html" }
    ],
    "headers": [
      {
        "source": "/downloads/*.apk",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"app-release.apk\"" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  }
}
